
CREATE TABLE Student_fee_details(
rollno INT PRIMARY KEY,
name VARCHAR(50),
fee_deposited INT,
fee_date DATE
);

CREATE TABLE Student_fee_details_old(
rollno INT,
name VARCHAR(50),
fee_deposited INT,
fee_date DATE,
updated_on DATETIME
);

DELIMITER //

