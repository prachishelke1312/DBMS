CREATE TABLE Library(
book_id INT PRIMARY KEY,
book_name VARCHAR(50),
author VARCHAR(50),
price INT
);

CREATE TABLE Library_Audit(
audit_id INT AUTO_INCREMENT PRIMARY KEY,
book_id INT,
book_name VARCHAR(50),
author VARCHAR(50),
price INT,
action_type VARCHAR(20),
action_date DATETIME
);

DELIMITER //

CREATE TRIGGER trg_library_update
BEFORE UPDATE
ON Library
FOR EACH ROW
BEGIN

INSERT INTO Library_Audit
(
book_id,
book_name,
author,
price,
action_type,
action_date
)

VALUES
(
OLD.book_id,
OLD.book_name,
OLD.author,
OLD.price,
'UPDATE',
NOW()
);

END //

CREATE TRIGGER trg_library_delete
BEFORE DELETE
ON Library
FOR EACH ROW
BEGIN

INSERT INTO Library_Audit
(
book_id,
book_name,
author,
price,
action_type,
action_date
)

VALUES
(
OLD.book_id,
OLD.book_name,
OLD.author,
OLD.price,
'DELETE',
NOW()
);

END //

DELIMITER ;

