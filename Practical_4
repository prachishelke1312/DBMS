-- =====================================================
-- i) Department location where Ram works
-- =====================================================

SELECT a.Dept_location
FROM Emp e
JOIN Dept d
ON e.Dept_no = d.Dept_no
JOIN Address a
ON d.Dept_name = a.Dept_name
WHERE e.Emp_name = 'Ram';



-- =====================================================
-- ii) Create view for total employees in each department
-- =====================================================

CREATE VIEW Dept_Count AS
SELECT d.Dept_name,
       COUNT(e.Emp_no) AS Total_Employees
FROM Dept d
LEFT JOIN Emp e
ON d.Dept_no = e.Dept_no
GROUP BY d.Dept_name
ORDER BY Total_Employees ASC;



-- View data

SELECT * FROM Dept_Count;



-- =====================================================
-- iii) Department where no employee works
-- =====================================================

SELECT d.Dept_name
FROM Dept d
LEFT JOIN Emp e
ON d.Dept_no = e.Dept_no
WHERE e.Emp_no IS NULL;



-- =====================================================
-- c) MOVIES, DIRECTOR, RATING
-- =====================================================

-- Create MOVIES table

CREATE TABLE MOVIES (
    Mov_Id INT PRIMARY KEY,
    Mov_Title VARCHAR(50),
    Mov_Year INT,
    Dir_Id INT
);



-- Create DIRECTOR table

CREATE TABLE DIRECTOR (
    Dir_Id INT PRIMARY KEY,
    Dir_Name VARCHAR(50)
);



-- Create RATING table

CREATE TABLE RATING (
    MOV_Id INT,
    Rev_Stars INT
);



