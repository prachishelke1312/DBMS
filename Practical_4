
-- =====================================================
-- a) SUPPLIER, PARTS, SHIPMENTS
-- =====================================================

-- Create Supplier table

CREATE TABLE Supplier (
    SNO INT PRIMARY KEY,
    Sname VARCHAR(50),
    Status VARCHAR(20),
    City VARCHAR(30)
);

-- Create Parts table

CREATE TABLE Parts (
    PNO INT PRIMARY KEY,
    Pname VARCHAR(50),
    Color VARCHAR(20),
    Weight INT,
    City VARCHAR(30)
);

-- Create Shipments table

CREATE TABLE Shipments (
    SNO INT,
    PNO INT,
    QTY INT
);



