CREATE TABLE Stud_Marks(
Roll_no INT PRIMARY KEY,
name VARCHAR(50),
total_marks INT,
category VARCHAR(50)
);

INSERT INTO Stud_Marks VALUES
(1,'Rahul',1200,NULL),
(2,'Amit',950,NULL),
(3,'Neha',850,NULL),
(4,'Pooja',700,NULL);

DELIMITER //

CREATE PROCEDURE student_category()

BEGIN

DECLARE rno INT;
DECLARE marks INT;
DECLARE done INT DEFAULT 0;

DECLARE cur CURSOR FOR
SELECT Roll_no,total_marks FROM Stud_Marks;

DECLARE CONTINUE HANDLER FOR NOT FOUND
SET done = 1;

OPEN cur;

read_loop: LOOP

FETCH cur INTO rno,marks;

IF done = 1 THEN
LEAVE read_loop;
END IF;

IF marks >= 990 AND marks <= 1500 THEN

UPDATE Stud_Marks
SET category='Distinction'
WHERE Roll_no = rno;

ELSEIF marks >= 900 AND marks <= 989 THEN

UPDATE Stud_Marks
SET category='First Class'
WHERE Roll_no = rno;

ELSEIF marks >= 825 AND marks <= 899 THEN

UPDATE Stud_Marks
SET category='Higher Second Class'
WHERE Roll_no = rno;

ELSE

UPDATE Stud_Marks
SET category='No Class'
WHERE Roll_no = rno;

END IF;

END LOOP;

CLOSE cur;

END //

DELIMITER ;

CALL student_category();

SELECT * FROM Stud_Marks;

