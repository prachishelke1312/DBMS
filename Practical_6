CREATE TABLE Areaofcircle(
radius FLOAT,
area FLOAT
);

INSERT INTO Areaofcircle(radius)
VALUES
(2),
(4),
(6),
(8);

DELIMITER //

CREATE PROCEDURE calculate_area()

BEGIN

DECLARE r FLOAT;
DECLARE a FLOAT;
DECLARE done INT DEFAULT 0;

DECLARE cur CURSOR FOR
SELECT radius FROM Areaofcircle;

DECLARE CONTINUE HANDLER FOR NOT FOUND
SET done = 1;

OPEN cur;

read_loop: LOOP

FETCH cur INTO r;

IF done = 1 THEN
LEAVE read_loop;
END IF;

SET a = 3.14 * r * r;

UPDATE Areaofcircle
SET area = a
WHERE radius = r;

END LOOP;

CLOSE cur;

END //

DELIMITER ;

CALL calculate_area();

SELECT * FROM Areaofcircle;